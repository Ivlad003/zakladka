{
  "name": "zakladka-reader",
  "private": true,
  "version": "0.1.0",
  "description": "Закладка — PWA-читалка EPUB / PDF / DjVu з AI-агентами, нотатками та малюванням",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "copy-assets": "node scripts/copy-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mozilla/readability": "^0.6.0",
    "aws4fetch": "^1.0.20",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "djvu-rs": "0.45.0",
    "dompurify": "^3.4.17",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
